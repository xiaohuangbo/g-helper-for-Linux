#!/usr/bin/env python3
import sys
from pathlib import Path

def _bootstrap() -> None:
    here = Path(__file__).resolve()
    source = here.parents[1]
    if (source / "ghelper" / "__init__.py").is_file():
        sys.path.insert(0, str(source))
        return
    lib = Path("/usr/lib/ghelper")
    if (lib / "ghelper" / "__init__.py").is_file():
        sys.path.insert(0, str(lib))

_bootstrap()

from ghelper.entry import main

raise SystemExit(main())
