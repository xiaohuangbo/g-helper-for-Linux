# ASUS HID devices used by G-Helper (mice, keyboards, headsets, Aura).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", TAG+="uaccess", GROUP="users", MODE="0660"

# Fn hotkeys exported by asus-nb-wmi.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", TAG+="uaccess", GROUP="users", MODE="0660"
